{
  "name": "structmark-language-core",
  "version": "2.0.0",
  "type": "module",
  "description": "StructMark 2.0 deterministic structural markup language core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oMiki0826o/StructMark.git"
  },
  "bugs": {
    "url": "https://github.com/oMiki0826o/StructMark/issues"
  },
  "homepage": "https://omiki0826o.github.io/StructMark/",
  "files": [
    "bin",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "examples",
    "src/v2",
    "experimental/v2",
    "VALIDATION.md"
  ],
  "main": "./src/v2/index.mjs",
  "types": "./src/v2/index.d.mts",
  "exports": {
    ".": {
      "types": "./src/v2/index.d.mts",
      "import": "./src/v2/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.v2.json",
    "test": "npm run build && node --test experimental/v2/tests/*.test.mjs",
    "fuzz": "npm run fuzz:v2",
    "benchmark:tokens": "python3 benchmark/tokens.py",
    "benchmark:optimization": "python3 benchmark/optimization.py",
    "benchmark:three-way": "node benchmark/three-way.mjs \"$ATDOC_DIST\" && python3 benchmark/three-way-tokens.py",
    "benchmark:semantic": "node --test experimental/v2/tests/v2-release.test.mjs",
    "benchmark:perf": "node benchmark/semantic-equivalence.mjs",
    "demo": "node bin/sm2.mjs --help",
    "check": "npm test && npm run fuzz:v2 && npm run docs:check && npm run benchmark:semantic",
    "prepublishOnly": "npm run build && npm test",
    "cli": "node bin/sm2.mjs",
    "test:cli": "node --test experimental/v2/tests/cli.test.mjs",
    "docs:check": "node scripts/docs-check-v2.mjs",
    "docs:export": "node scripts/docs-check-v2.mjs --export",
    "test:v2": "node --test experimental/v2/tests/*.test.mjs",
    "cli:v2": "node bin/sm2.mjs",
    "test:v2:cli": "node --test experimental/v2/tests/cli.test.mjs",
    "check:v2": "npm run test:v2 && npm run fuzz:v2 && node scripts/validate-vscode-assets.mjs",
    "prepare:vscode": "node scripts/prepare-vscode.mjs",
    "fuzz:v2": "node scripts/v2-fuzz.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "yaml": "^2.9.1"
  },
  "bin": {
    "structmark": "./bin/sm2.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
